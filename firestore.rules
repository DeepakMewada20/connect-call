rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection:
    // Authenticated users can create, update, or delete only their own profile document.
    // Reading individual user docs is allowed for authenticated users.
    // Querying (listing) is strictly restricted to batch queries with limit <= 30
    // to prevent downloading the full user base (Phase 2 Privacy Requirement).
    match /users/{userId} {
      allow create, update, delete: if isOwner(userId);
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.query.limit <= 30;

      // Call History Subcollection:
      // Each authenticated user can only read and write their own call history.
      match /call_history/{callId} {
        allow read, write: if isOwner(userId);
      }

      // Blocked Users Subcollection:
      // Each authenticated user can only read and manage their own blocked users list.
      match /blockedUsers/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Calls Collection (prepared for calling functionality in future phases):
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
