rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection:
    // Authenticated users can only read, create, or update their own profile document.
    // This prevents exposing all registered users until contact matching is introduced in Phase 2.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      // Call History Subcollection (Phase 8):
      // Each authenticated user can only read and write their own call history.
      match /call_history/{callId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Calls Collection (prepared for calling functionality in future phases):
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
